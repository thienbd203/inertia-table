{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "declaration": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "vitest/globals"]
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "tests-js/**/*.ts",
        "vite.config.ts"
    ]
}
